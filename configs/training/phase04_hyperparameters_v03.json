{
  "dataset_version": "phase03_v0.3",
  "seed": 3001,
  "training_chain": "Base Model -> SFT LoRA -> SFT checkpoint / merged adapter source -> DPO LoRA",
  "no_direct_dpo": true,
  "formal_experiment_boundary": {
    "FORMAL_MODELS": ["1.7B", "4B"],
    "FORMAL_DATASET_VERSION": "v0.3",
    "model_id_map": {
      "1.7B": "Qwen/Qwen3-1.7B-Base",
      "4B": "Qwen/Qwen3-4B-Instruct-2507"
    },
    "note": "model_id is the Phase02 FINAL actual model. 4B is Instruct-2507, NOT 4B-Base. 0.6B and v0.1 are historical-only and must not enter the formal experiment."
  },
  "template": {
    "1.7B": "qwen3",
    "4B": "qwen3_nothink",
    "note": "4B Instruct-2507 uses template=qwen3_nothink (approved round 2). Do NOT use template=qwen3 + enable_thinking:false for 4B. Training and inference/evaluation must use a consistent template.",
    "llamafactory_version": "0.9.5",
    "qwen3_nothink_registered": true
  },
  "structured_runtime": {
    "implementation": "lm-format-enforcer",
    "module": "lmformatenforcer",
    "version": "0.11.3",
    "schema_source": "canonical (build_canonical_decision_json_schema)",
    "fail_closed": true
  },
  "sft_formal": [
    {
      "model_key": "1.7B",
      "model_id": "Qwen/Qwen3-1.7B-Base",
      "config": "configs/training/phase04_sft_qwen3_1_7b.yaml",
      "template": "qwen3",
      "train": 540,
      "val": 60,
      "output_dir": "experiments/phase04/sft_qwen3_1_7b"
    },
    {
      "model_key": "4B",
      "model_id": "Qwen/Qwen3-4B-Instruct-2507",
      "config": "configs/training/phase04_sft_qwen3_4b.yaml",
      "template": "qwen3_nothink",
      "train": 540,
      "val": 60,
      "output_dir": "experiments/phase04/sft_qwen3_4b"
    }
  ],
  "dpo_formal": [
    {
      "model_key": "1.7B",
      "model_id": "Qwen/Qwen3-1.7B-Base",
      "config": "configs/training/phase04_dpo_qwen3_1_7b.yaml",
      "continues_from": "experiments/phase04/sft_qwen3_1_7b/checkpoint-best",
      "template": "qwen3",
      "per_device_train_batch_size": 1,
      "per_device_eval_batch_size": 1,
      "train": 216,
      "val": 24
    },
    {
      "model_key": "4B",
      "model_id": "Qwen/Qwen3-4B-Instruct-2507",
      "config": "configs/training/phase04_dpo_qwen3_4b.yaml",
      "continues_from": "experiments/phase04/sft_qwen3_4b/checkpoint-best",
      "template": "qwen3_nothink",
      "per_device_train_batch_size": 1,
      "per_device_eval_batch_size": 1,
      "train": 216,
      "val": 24
    }
  ],
  "historical": {
    "base_model": "Qwen/Qwen3-0.6B-Base",
    "note": "0.6B is preserved for reproduction only; excluded from the formal experiment.",
    "sft": {
      "config": "configs/training/phase04_sft_qwen3_0_6b.yaml",
      "finetuning_type": "lora",
      "lora_rank": 16,
      "lora_alpha": 32,
      "lora_dropout": 0.05,
      "learning_rate": 1.0e-4,
      "num_train_epochs": 3,
      "per_device_train_batch_size": 2,
      "per_device_eval_batch_size": 2,
      "gradient_accumulation_steps": 8,
      "cutoff_len": 2048,
      "lr_scheduler_type": "cosine",
      "warmup_ratio": 0.1,
      "bf16": true,
      "fp16": false,
      "gradient_checkpointing": true,
      "dataset": "data/processed/sft/v0.3/train.jsonl + val.jsonl"
    },
    "dpo": {
      "config": "configs/training/phase04_dpo_qwen3_0_6b.yaml",
      "continues_from": "experiments/phase04/sft_qwen3_0_6b/checkpoint-best",
      "finetuning_type": "lora",
      "lora_rank": 16,
      "lora_alpha": 32,
      "lora_dropout": 0.05,
      "learning_rate": 5.0e-6,
      "num_train_epochs": 1,
      "per_device_train_batch_size": 1,
      "per_device_eval_batch_size": 1,
      "gradient_accumulation_steps": 8,
      "cutoff_len": 2048,
      "lr_scheduler_type": "cosine",
      "warmup_ratio": 0.1,
      "bf16": true,
      "fp16": false,
      "gradient_checkpointing": true,
      "pref_beta": 0.1,
      "pref_loss": "sigmoid",
      "dataset": "data/processed/dpo/v0.3/train.jsonl + val.jsonl"
    }
  }
}
